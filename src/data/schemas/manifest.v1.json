{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiangong.ai/data/manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "capabilityVersion",
    "minimumCliVersion",
    "provider",
    "sourceCategory",
    "endpoints",
    "license",
    "credentials",
    "limits",
    "diagnostics",
    "freshness",
    "limitations",
    "operations",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.data.manifest.v1" },
    "capabilityId": { "$ref": "#/$defs/id" },
    "capabilityVersion": { "$ref": "#/$defs/version" },
    "minimumCliVersion": { "$ref": "#/$defs/version" },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "name"],
      "properties": {
        "providerId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "sourceCategory": { "type": "string", "minLength": 1 },
    "endpoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "restrictions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "restrictions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": { "$ref": "#/$defs/credential" }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static", "live"],
      "properties": {
        "static": { "const": true },
        "live": { "type": "boolean" }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "manifestDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeoutMs",
        "maxRequestBytes",
        "maxResponseBytes",
        "maxPages",
        "maxRecords",
        "maxRetries",
        "maxRetryDelayMs",
        "maxRedirects"
      ],
      "properties": {
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxRequestBytes": { "type": "integer", "minimum": 1 },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxPages": { "type": "integer", "minimum": 1 },
        "maxRecords": { "type": "integer", "minimum": 1 },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "maxRetryDelayMs": { "type": "integer", "minimum": 0 },
        "maxRedirects": { "type": "integer", "minimum": 0 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointId",
        "baseUrl",
        "pathPrefixes",
        "allowedMethods",
        "allowedContentTypes"
      ],
      "properties": {
        "endpointId": { "$ref": "#/$defs/id" },
        "baseUrl": { "type": "string", "pattern": "^https://" },
        "pathPrefixes": { "$ref": "#/$defs/stringArray" },
        "allowedMethods": {
          "type": "array",
          "items": { "enum": ["GET", "POST"] },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowedContentTypes": { "$ref": "#/$defs/stringArray" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialId",
        "environmentVariable",
        "required",
        "endpointIds",
        "injection"
      ],
      "properties": {
        "credentialId": { "$ref": "#/$defs/id" },
        "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "required": { "type": "boolean" },
        "endpointIds": { "$ref": "#/$defs/stringArray" },
        "injection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "prefix"],
          "properties": {
            "kind": { "const": "header" },
            "name": { "type": "string", "minLength": 1 },
            "prefix": { "type": "string" }
          }
        }
      }
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "digest"],
      "properties": {
        "schemaId": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "operationVersion",
        "summary",
        "inputSchema",
        "outputSchema",
        "limits"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "operationVersion": { "$ref": "#/$defs/version" },
        "summary": { "type": "string", "minLength": 1 },
        "inputSchema": { "$ref": "#/$defs/schemaRef" },
        "outputSchema": { "$ref": "#/$defs/schemaRef" },
        "limits": { "$ref": "#/$defs/limits" }
      }
    }
  }
}
